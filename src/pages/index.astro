---
import Layout from "../layouts/Layout.astro";
import { WindowManager } from "../components/WindowSystem/WindowManager.tsx";
import { TutorialDialogue } from "../components/Tutorial/TutorialDialogue.tsx";
import { CommandPalette } from "../components/CommandPalette.tsx";
import { BadApplePlayer } from "../components/BadApple/BadApplePlayer.tsx";
import {createWindow} from "../lib/windowManager.ts";
import {defaultWindowConfigs} from "../lib/windowConfigs.ts";
---

<Layout>
    <script>
        import {randomPalette, toggleShaderBackground} from "../lib/background.ts";

        const konamiCode = [
            "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
            "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a",
        ];
        let konamiProgress = 0;

        document.addEventListener("keydown", (e) => {
            if (e.key === "Shift") {
                randomPalette();
            }

            const key = e.key.toLowerCase();
            const expectedKey = konamiCode[konamiProgress].toLowerCase();
            konamiProgress = key === expectedKey
                ? konamiProgress + 1
                : key === konamiCode[0].toLowerCase() ? 1 : 0;

            if (konamiProgress === konamiCode.length) {
                toggleShaderBackground();
                konamiProgress = 0;
            }
        })
    </script>
    <canvas id="shader"></canvas>
    <WindowManager client:load />
    <BadApplePlayer client:load />
    <CommandPalette client:load />
        <TutorialDialogue client:load steps={[
            {
                id: "welcome",
                text: "Hey there! Welcome to my little corner of the internet!",
            },
            {
                id: "header",
                text: "Up here is the navigation. You can click these to open different sections of the site.",
                target: "header-nav",
            },
            {
                id: "dock",
                text: "This is the dock! All kinds of cool apps live here. Definitely check them out.",
                target: "dock",
            },
            {
                id: "palette",
                kind: "palette",
                text: "Change the background to something you like!",
            },
            {
                id: "done",
                text: "That's it! Have fun exploring. If you like this website send me a message to let me know (or just to say hi!) See ya!",
            }
        ]}
                          onComplete={"about"}
        />
</Layout>
